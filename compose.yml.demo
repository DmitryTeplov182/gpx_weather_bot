services:
  announce-bot:
    image: ${IMAGE_NAME:-announce-bot:local}
    build: .
    container_name: announce-bot
    command: ["python3", "announce_bot.py"]
    env_file:
      - .env_announce
    volumes:
      # Монтируем файлы с точками старта/финиша для возможности редактирования
      - ./start_points.json:/app/start_points.json:ro
      - ./finish_points.json:/app/finish_points.json:ro
      # Монтируем маршруты и быстрые маршруты
      - ./routes.json:/app/routes.json:ro
      - ./ready_routes.json:/app/ready_routes.json:ro
      # Монтируем кэш для сохранения GPX файлов между перезапусками
      - ./cache:/app/cache
    restart: always

  weather-bot:
    image: ${IMAGE_NAME:-announce-bot:local}
    build: .
    container_name: weather-bot
    command: ["python3", "weather_bot.py"]
    env_file:
      - .env_weather
    volumes:
      - ./cache:/app/cache
    restart: always
