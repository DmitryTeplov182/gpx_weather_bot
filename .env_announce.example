TELEGRAM_TOKEN=your_announce_bot_token_here
TIMEZONE=Europe/Belgrade
# Необязательно: крупный полупрозрачный текст на дашборде. Пусто — без вотермарки.
# DASHBOARD_WATERMARK=

# Необязательно: ключи RideWithGPS. Маршруты RideWithGPS работают и без них —
# ключи включают запасной путь через официальный API v1, если основной
# эндпоинт недоступен. Заводятся на https://ridewithgps.com/api/api_clients,
# срока жизни не имеют.
# RWGPS_API_KEY=
# RWGPS_AUTH_TOKEN=
